PORT=
# OBRIGATORIO quando NODE_ENV=production: o servidor recusa subir sem um
# segredo proprio de no minimo 32 caracteres aleatorios (V3 P2.7 BLOCO Q,
# ver server/config/jwtSecret.js). Em dev/teste pode ficar vazio.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=
NODE_ENV=
API_URL=

# ── Observabilidade (Control Center) ─────────────────────────────
# Todas opcionais. Sem nenhuma delas o servidor usa os padrões abaixo.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_RETENTION_DAYS=7
OBSERVABILITY_MAX_ROWS=50000
OBSERVABILITY_SLOW_MS=1000
OBSERVABILITY_CAPTURE_STACK=true
OBSERVABILITY_CLIENT_EVENTS=true

# ── Editor de imagem do Estúdio de Templates ─────────────────────
# Opcional. Vazio = nenhum provedor de IA de imagem configurado; o editor
# funciona normalmente (Sharp + Fabric) e apenas esconde os recursos de IA.
# Ver docs/DESIGN_IMAGE_EDITOR.md para plugar Photoroom/Cloudinary/remove.bg.
IMAGE_AI_PROVIDER=

# ── IA de texto (SEO de anúncios ML + otimizador legado) ─────────
# Provedores: anthropic (padrão, Haiku claude-haiku-4-5-20251001) e mimo
# (Xiaomi MiMo, mimo-v2.6-pro). Sem as linhas opcionais, tudo usa Anthropic +
# Haiku. O otimizador legado é sempre Anthropic. Ver docs/AI_PROVIDER.md.
ANTHROPIC_API_KEY=
# Opcional: modelo padrão do Anthropic (vazio = Haiku padrão).
ANTHROPIC_MODEL=
# Só quando alguma task usa mimo.
MIMO_API_KEY=
# Opcional: modelo padrão da MiMo (vazio = mimo-v2.6-pro).
MIMO_MODEL=
# Opcional: provedor padrão das tasks de SEO (anthropic | mimo; vazio = anthropic).
AI_PROVIDER=
# Opcionais: provedor por task; vazio = AI_PROVIDER.
AI_SEO_TITLE_PROVIDER=
AI_SEO_DESCRIPTION_PROVIDER=
# Opcionais: modelo por task (ID do provedor da task); vazio = padrão do provedor.
AI_SEO_TITLE_MODEL=
AI_SEO_DESCRIPTION_MODEL=
# Autorreparo da descrição SEO (1/true/on liga; vazio = desligado): no máximo
# 1 chamada de reparo restrita aos trechos rejeitados pela validação.
SEO_DESCRICAO_AUTORREPARO=

# Unificação de Clientes: executar somente após revisão/homologação/autorização.
CLIENTES_UNIFICACAO_EXECUTE_ENABLED=false
CLIENTES_UNIFICACAO_ROLLBACK_ENABLED=false
CLIENTES_UNIFICACAO_UI_ENABLED=false

# ── Gateway Shopee (saída com IPv4 fixo) ─────────────────────────
# Opcionais. Sem elas o servidor sobe normalmente; o client do gateway fica
# "não configurado" e nada é chamado. O OAuth LIVE (token/get) exige o gateway.
# Ver docs/integracoes/SHOPEE_FIXED_IP_GATEWAY.md.
# URL https do gateway na VPS (sem path). Temporário: https://157-230-128-41.sslip.io
SHOPEE_GATEWAY_URL=
# Mesmo valor de GATEWAY_SHARED_SECRET no gateway. Mínimo 32 caracteres.
SHOPEE_GATEWAY_SECRET=
# Opcional (padrão 15000).
SHOPEE_GATEWAY_TIMEOUT_MS=

# ── Shopee OAuth — apps de TESTE (sandbox) ───────────────────────
# Só TESTE. Produção terá variáveis próprias; nunca reutilize estas.
# Partner ID/Key do app Marketing de teste (fornecidos pela Matriz).
# NUNCA versionar valores; preencher só no painel do Render / ambiente local.
SHOPEE_TEST_MARKETING_PARTNER_ID=
SHOPEE_TEST_MARKETING_PARTNER_KEY=
# URL pública do callback, sem query (ex.: https://<host>/shopee/callback).
# O domínio precisa bater com o cadastrado no app da Shopee.
SHOPEE_TEST_REDIRECT_URL=
# Opcionais. Origem: só hosts de teste conhecidos (padrão
# https://partner.test-stable.shopeemobile.com). Transporte: direct (padrão)
# ou gateway (usa SHOPEE_GATEWAY_*; o gateway precisa apontar p/ o host de teste).
SHOPEE_TEST_API_ORIGIN=
SHOPEE_TEST_TRANSPORT=
SHOPEE_TEST_TIMEOUT_MS=

# ── Shopee OAuth — apps LIVE (produção) ──────────────────────────
# Separadas do TEST: nunca reutilize SHOPEE_TEST_* aqui. NUNCA versionar valores.
SHOPEE_LIVE_MARKETING_PARTNER_ID=
SHOPEE_LIVE_MARKETING_PARTNER_KEY=
# https, sem query (ex.: https://<host>/shopee/callback). Mesmo callback do TEST:
# o ambiente é decidido pelo state no servidor.
SHOPEE_LIVE_REDIRECT_URL=
# Origem da API LIVE (https, só origem). SEM padrão no código: confirmar com
# scripts/shopeeLiveSignProbe.js. Hosts de teste/sandbox são recusados.
SHOPEE_LIVE_API_ORIGIN=
# Obrigatório: só "gateway" (saída pelo IPv4 fixo da allowlist da Shopee).
# Vazio, "direct" ou outro valor = LIVE não configurado. Exige também
# SHOPEE_GATEWAY_URL e SHOPEE_GATEWAY_SECRET válidos. Timeout opcional (padrão 10000).
SHOPEE_LIVE_TRANSPORT=
SHOPEE_LIVE_TIMEOUT_MS=
# Chave AES-256-GCM dos tokens Shopee em repouso (shopee_grants): 32 bytes em
# hex (64 caracteres) ou base64. Ex. p/ gerar: openssl rand -hex 32
# Sem ela o LIVE fica "não configurado". Trocar a chave invalida os grants salvos.
SHOPEE_TOKEN_ENCRYPTION_KEY=

# Refresh automático dos grants Shopee LIVE (access_token/get pelo gateway).
# Opt-in: só "true" liga. Exige o LIVE configurado (inclusive o gateway) e
# /api/v2/auth/access_token/get em SHOPEE_ALLOWED_PATHS no gateway.
SHOPEE_LIVE_REFRESH_WORKER_ENABLED=
# Opcional: intervalo do ciclo em ms (padrão 600000 = 10 min; mínimo 60000).
SHOPEE_LIVE_REFRESH_INTERVAL_MS=

# Worker de refresh de tokens Mercado Livre. Ausente = ligado (padrão).
# Use "false" SÓ em instância temporária ligada ao mesmo banco (ex.: teste do
# OAuth Shopee), para ela não tentar renovar os grants ML reais.
ML_TOKEN_REFRESH_WORKER_ENABLED=
