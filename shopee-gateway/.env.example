# Gateway Shopee — variáveis de ambiente (SÓ placeholders; nunca commitar valor real).
# Em produção estas variáveis vivem em /etc/shopee-gateway/gateway.env (fora do repo).

# Obrigatório. Mesmo valor de SHOPEE_GATEWAY_SECRET no Render. Mínimo 32 caracteres.
# Gerar com: node scripts/gen-secret.js
GATEWAY_SHARED_SECRET=

# Origem da API Shopee (protocolo + host, sem path). https obrigatório em produção.
# PENDENTE: preencher com o host oficial depois de confirmado na documentação Shopee.
# Vazio = /forward responde CONFIG_MISSING (health e probe/ip seguem funcionando).
SHOPEE_API_ORIGIN=

# Paths exatos permitidos, separados por vírgula (sem curinga, sem query).
# PENDENTE: preencher com os paths oficiais depois de confirmação na documentação Shopee.
# Vazio = nenhum path passa.
SHOPEE_ALLOWED_PATHS=

# Escuta só em loopback; o Caddy faz 443 → 127.0.0.1:PORT.
HOST=127.0.0.1
PORT=8787

# Serviço externo de descoberta de IP (texto "1.2.3.4" ou JSON {"ip": "..."}).
IP_PROBE_URL=https://api.ipify.org

# Limites (defaults seguros; só mude com motivo).
UPSTREAM_TIMEOUT_MS=10000
AUTH_WINDOW_SECONDS=60
MAX_BODY_BYTES=65536
MAX_RESPONSE_BYTES=1048576
MAX_QUERY_LENGTH=4096
MAX_NONCES=10000
MAX_INFLIGHT=32

NODE_ENV=production
