# /etc/shopee-gateway/gateway.env — modelo. NÃO versionar o arquivo real.
# chown root:shopee-gw /etc/shopee-gateway/gateway.env && chmod 0640 ...
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
GATEWAY_SHARED_SECRET=
# Host oficial e lista EXATA de paths (vírgula, sem curinga). LIVE hoje:
#   SHOPEE_API_ORIGIN=https://partner.shopeemobile.com
#   SHOPEE_ALLOWED_PATHS=/api/v2/auth/token/get,/api/v2/auth/access_token/get
# (token/get = 1º grant do OAuth; access_token/get = refresh do grant).
SHOPEE_API_ORIGIN=
SHOPEE_ALLOWED_PATHS=
IP_PROBE_URL=https://api.ipify.org
UPSTREAM_TIMEOUT_MS=10000
