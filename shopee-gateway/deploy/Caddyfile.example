# /etc/caddy/Caddyfile
# Exemplo: troque gateway.exemplo.com pelo subdomínio real. O registro DNS A
# precisa apontar para o IPv4 do Droplet ANTES de o Caddy emitir o certificado.
gateway.exemplo.com {
	# Corpo acima disso nem chega ao Node (o gateway também limita).
	request_body {
		max_size 128KB
	}

	reverse_proxy 127.0.0.1:8787

	# Log de acesso do Caddy: sem query string (o gateway não usa query, mas
	# qualquer coisa que um scanner mandar não vai para o disco).
	log {
		output file /var/log/caddy/shopee-gateway.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete *
				}
				request>headers>X-Vf-Signature delete
				request>headers>X-Vf-Nonce delete
			}
		}
	}
}
