# /etc/shopee-gateway/gateway.env — modelo. NÃO versionar o arquivo real.
# chown root:shopee-gw /etc/shopee-gateway/gateway.env && chmod 0640 ...
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
GATEWAY_SHARED_SECRET=
# PENDENTE DE DOCUMENTAÇÃO SHOPEE: host oficial e paths oficiais.
SHOPEE_API_ORIGIN=
SHOPEE_ALLOWED_PATHS=
IP_PROBE_URL=https://api.ipify.org
UPSTREAM_TIMEOUT_MS=10000
